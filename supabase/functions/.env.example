# Generate a long random value and configure it as an Edge Function secret.
INVITE_RATE_LIMIT_PEPPER=replace-with-a-long-random-secret

# Comma-separated origins allowed to call claim-invite from a browser.
# Include the production site and local development origins when needed.
ALLOWED_ORIGINS=https://example.com,http://127.0.0.1:8000,http://localhost:8000

# Transactional email notifications.
# Supabase provides these in deployed Edge Functions. Keep them here for local
# development and smoke tests only.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ADMIN_EMAIL=liviaemessias23@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-app-password-or-smtp-password
SMTP_FROM_EMAIL=replace-with-verified-from-email
SMTP_FROM_NAME=Livia & Messias
